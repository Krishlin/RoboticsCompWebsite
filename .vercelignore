.git/
seed/

# Secrets. git already ignores this, but the CLI uploads by this file and not
# by .gitignore, so a `vercel deploy` from a developer's machine would put the
# real .env in the bundle. Vercel holds the deployed values itself, under
# Settings -> Environment Variables.
.env
.env.*
!.env.example

migrate_add_replaces_match_id.py
seed_for_testing.py

# The 20 MB of source CAD renders. tools/render_bot_views.py cuts them down
# to the WebP in app/static/img/bot, and the deployed app never reads these.
Stemsters bod renders/
